# apps/web の環境変数（開発用の例。本番の値はここに書かない）

# Postgres。Route Handler がここへつなぎ、リクエストごとに role と JWT claims を設定して RPC を呼ぶ
DATABASE_URL=postgres://postgres@127.0.0.1:54329/mj_dev

# セッション cookie と対局サーバー用トークン（HS256）の秘密鍵。32文字以上。対局サーバーの APP_JWT_SECRET と同じ値
APP_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# 対局サーバー（サーバー間通信用の URL と共有鍵）
TABLE_SERVER_URL=http://127.0.0.1:8787
TABLE_SERVER_KEY=dev-only-table-server-key

# ブラウザから見える対局サーバーの URL（CPU練習の POST /practice と WebSocket）
NEXT_PUBLIC_TABLE_SERVER_URL=http://127.0.0.1:8787
NEXT_PUBLIC_TABLE_SERVER_WS=ws://127.0.0.1:8787/ws

# 本番（Supabase Auth を使う場合のみ。両方あると SupabaseAuthProvider に切り替わる）※未検証
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
